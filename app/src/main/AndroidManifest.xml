<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.qinghe.liteai.app.LiteAiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiteAi">
        <activity
            android:name="com.qinghe.liteai.AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.qinghe.liteai.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.qinghe.liteai.ModelManagementActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.qinghe.liteai.HistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.qinghe.liteai.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
